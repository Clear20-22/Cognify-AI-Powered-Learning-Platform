# ============================================================================
# Cognify AI Learning Platform - Environment Variables
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AI Model API Keys (Primary: Groq, Fallback: Gemini)
# ----------------------------------------------------------------------------
# Optional: If omitted, platform boots into built-in Demo Mock Engine
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------------------------
# 2. Database Configuration
# ----------------------------------------------------------------------------
# Optional: If omitted or unreachable, platform boots into InMemoryDataStore
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=cognify_db

# ----------------------------------------------------------------------------
# 3. Security & Authentication
# ----------------------------------------------------------------------------
SECRET_KEY=cognify-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------------------
# 4. Server Configuration & CORS
# ----------------------------------------------------------------------------
PROJECT_NAME=Cognify AI Learning Platform
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
