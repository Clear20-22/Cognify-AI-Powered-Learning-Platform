# ============================================================================
# Cognify AI Learning Platform - Environment Variables (TEMPLATE)
# ============================================================================
# Copy this file to backend/.env and fill in your own values:
#     cp .env.example backend/.env
# backend/.env is gitignored. Never commit real keys or connection strings.
# Keep the key names exactly as written (e.g. MONGODB_URI, not MONGODB_URL).

# ----------------------------------------------------------------------------
# 1. AI Model API Keys (Primary: Groq, Fallback: Gemini)
# ----------------------------------------------------------------------------
# Optional: If omitted, platform boots into built-in Demo Mock Engine
# Get keys at https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------------------------
# 2. Database Configuration
# ----------------------------------------------------------------------------
# Optional: If omitted or unreachable, platform boots into InMemoryDataStore
# (all data is lost when the server restarts).
# Local MongoDB:  mongodb://localhost:27017
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=cognify_db

# ----------------------------------------------------------------------------
# 3. Security & Authentication
# ----------------------------------------------------------------------------
# Use a long random value. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------------------
# 4. CORS (frontend origins allowed to call the API)
# ----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
